#!/bin/sh /etc/rc.common
# tailscaled: static binary. This image has no iptables, and tailscale 1.104 moved
# --netfilter-mode from the daemon to "tailscale up", so the daemon is plain and the
# mode is set once at login (see /etc/tailscale/README or the install notes).
START=90
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /var/run/tailscale /etc/tailscale
	procd_open_instance
	procd_set_param command /usr/sbin/tailscaled \
		--state=/etc/tailscale/tailscaled.state \
		--socket=/var/run/tailscale/tailscaled.sock \
		--port=41641 \
		--tun=tailscale0
	procd_set_param respawn 3600 5 0
	procd_set_param limits nofile="65536 65536"
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
